# ---- 运行产物 ----
logs/
state/
*.log

# ---- 注意：release/**/config.ini 和 archive.ini 是随程序提供的空模板，会一起提交；
#      真实服务器地址 / 账号 / 密码请放在仓库外，不要写进这两个文件再提交 ----

# ---- 编译产物：release 里的 exe 会一起提交，方便直接从仓库取用；自测用临时 exe 不提交 ----
code/devtools/*.exe
*.pdb
*.obj

# ---- 开发自测临时目录 ----
_tests/
_3t/
_rt/
_probe/
*.part
*.synctmp

# ---- 计划任务临时文件 ----
task.xml
syncagent-task-*.xml
syncagent-schtasks-*.txt

# ---- 系统与编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ---- 打包产物 ----
dist/
