# ---- 运行产物 ----
logs/
state/
*.log

# ---- 本地真实配置（含服务器地址与账号密码，不要提交）----
release/**/config.ini
release/**/archive.ini

# ---- 编译产物：release 里的 exe 会一起提交，方便直接从仓库取用；自测用临时 exe 不提交 ----
code/devtools/*.exe
*.pdb
*.obj

# ---- 开发自测临时目录 ----
_tests/
_3t/
_rt/
_probe/
*.part
*.synctmp

# ---- 计划任务临时文件 ----
task.xml
syncagent-task-*.xml
syncagent-schtasks-*.txt

# ---- 系统与编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# ---- 打包产物 ----
dist/
